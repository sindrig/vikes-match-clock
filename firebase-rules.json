{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "$uid == auth.uid"
      },
      ".write": false
    },
    "auth": {
      "$user_id": {
        ".read": "$user_id == auth.uid || root.child('admins').child(auth.uid).val() == true"
      },
      ".read": "root.child('admins').child(auth.uid).val() == true",
      ".write": false
    },
    "invitations": {
      ".read": "root.child('admins').child(auth.uid).val() == true",
      ".write": false
    },
    "locations": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() == true"
    },
    "states": {
      "$location": {
        ".write": "root.child('auth').child(auth.uid).child($location).val() == true",
        ".read": true,
        "perimeter": {
          "goalScorerPreparation": {
            ".validate": "newData.val() == null || (newData.hasChildren(['jobId', 'rosterSignature', 'players']) && newData.child('jobId').isString() && newData.child('rosterSignature').isString() && newData.child('players').hasChildren())"
          },
          "goalVideo": {
            ".validate": "newData.val() == null || newData.hasChildren(['files'])",
            "$other": {
              ".validate": false
            },
            "files": {
              "$target": {
                ".validate": "newData.hasChildren(['name', 'source'])",
                "$other": {
                  ".validate": false
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 255"
                },
                "source": {
                  ".validate": "newData.isString() && newData.val().beginsWith('gs://') && newData.val().length <= 300"
                },
                "generation": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
                }
              }
            }
          },
          "scorerCelebration": {
            ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'ribbon' || newData.val() == 'tunnel' || newData.val() == 'wave' || newData.val() == 'procession' || newData.val() == 'cutout'))"
          },
          "idleClock": {
            ".validate": "newData.isBoolean()"
          },
          "playerDisplayStyle": {
            ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'plain' || newData.val() == 'glow' || newData.val() == 'streamer'))"
          },
          "substitutionStyle": {
            ".validate": "newData.val() == null || (newData.isString() && (newData.val() == 'static' || newData.val() == 'relay' || newData.val() == 'flash'))"
          },
          "brightnessAuto": {
            ".validate": "newData.val() == null || (newData.hasChildren(['enabled', 'min', 'max', 'exponent', 'cloudWeight', 'luxMin', 'luxMax', 'updatedAt']) && newData.child('enabled').isBoolean() && newData.child('min').isNumber() && newData.child('min').val() >= 0 && newData.child('max').isNumber() && newData.child('max').val() <= 100 && newData.child('min').val() <= newData.child('max').val() && newData.child('exponent').isNumber() && newData.child('exponent').val() >= 0.05 && newData.child('exponent').val() <= 2 && newData.child('cloudWeight').isNumber() && newData.child('cloudWeight').val() >= 0 && newData.child('cloudWeight').val() <= 1 && newData.child('luxMin').isNumber() && newData.child('luxMax').isNumber() && newData.child('luxMin').val() < newData.child('luxMax').val() && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now)",
            "enabled": {
              ".validate": "newData.isBoolean()"
            },
            "min": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "max": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "exponent": {
              ".validate": "newData.isNumber() && newData.val() >= 0.05 && newData.val() <= 2"
            },
            "cloudWeight": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "luxMin": {
              ".validate": "newData.isNumber()"
            },
            "luxMax": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          },
          "overlay": {
            ".validate": "newData.val() == null || (newData.hasChildren(['version', 'id']) && newData.child('id').isString() && newData.child('id').val().length >= 1 && newData.child('id').val().length <= 128 && ((newData.child('version').val() == 1 && !newData.hasChild('kind') && !newData.hasChild('player') && newData.hasChildren(['columns'])) || (newData.child('version').val() == 2 && newData.child('kind').val() == 'goal-scorer' && !newData.hasChild('columns') && newData.hasChildren(['player']) && newData.child('player').hasChildren(['id', 'name', 'number']) && newData.child('player').child('id').val().matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.child('player').child('name').isString() && newData.child('player').child('name').val().length >= 1 && newData.child('player').child('name').val().length <= 80 && newData.child('player').child('number').val().matches(/^[0-9]{1,4}$/))))",
            "$other": {
              ".validate": false
            },
            "version": {
              ".validate": "newData.val() == 1 || newData.val() == 2"
            },
            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },
            "columns": {
              "$columnIndex": {
                ".validate": "newData.hasChildren(['durationMs', 'files'])",
                "$other": {
                  ".validate": false
                },
                "durationMs": {
                  ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 120000"
                },
                "files": {
                  "$target": {
                    ".validate": "newData.hasChildren(['name', 'source'])",
                    "$other": {
                      ".validate": false
                    },
                    "name": {
                      ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 255"
                    },
                    "source": {
                      ".validate": "newData.isString() && newData.val().beginsWith('gs://') && newData.val().length <= 300"
                    },
                    "generation": {
                      ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
                    }
                  }
                }
              }
            },
            "kind": {
              ".validate": "newData.val() == 'goal-scorer'"
            },
            "player": {
              ".validate": "newData.hasChildren(['id', 'name', 'number'])",
              "$other": {
                ".validate": false
              },
              "id": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
              },
              "number": {
                ".validate": "newData.val().matches(/^[0-9]{1,4}$/)"
              }
            }
          }
        }
      }
    },
    "audit": {
      "$location": {
        ".read": "root.child('auth').child(auth.uid).child($location).val() == true",
        "$eventId": {
          ".write": "!data.exists() && newData.exists() && root.child('auth').child(auth.uid).child($location).val() == true",
          ".validate": "newData.hasChildren(['timestamp', 'uid', 'sessionId', 'action', 'stateArea', 'changes']) && newData.child('uid').val() == auth.uid && newData.child('timestamp').isNumber() && newData.child('sessionId').isString() && newData.child('action').isString() && (newData.child('stateArea').val() == 'match' || newData.child('stateArea').val() == 'controller' || newData.child('stateArea').val() == 'view' || newData.child('stateArea').val() == 'perimeter' || newData.child('stateArea').val() == 'clubOverrides') && newData.child('changes').val() != null"
        },
        ".indexOn": ["timestamp"]
      }
    },
    "perimeter": {
      "$location": {
        ".read": "root.child('auth').child(auth.uid).child($location).val() == true",
        ".write": false
      }
    },
    "presence": {
      "$location": {
        ".read": true,
        "$connectionId": {
          ".write": true,
          ".validate": "newData.hasChildren(['connectedAt']) && newData.child('connectedAt').isNumber()",
          "connectedAt": {
            ".validate": "newData.isNumber()"
          },
          "displayKind": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "label": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "resolution": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "error": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "errorAt": {
            ".validate": "newData.isNumber()"
          },
          "lastHeartbeat": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}

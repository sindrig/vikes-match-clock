{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "$uid == auth.uid"
      },
      ".write": false
    },
    "auth": {
      "$user_id": {
        ".read": "$user_id == auth.uid || root.child('admins').child(auth.uid).val() == true"
      },
      ".read": "root.child('admins').child(auth.uid).val() == true",
      ".write": false
    },
    "invitations": {
      ".read": "root.child('admins').child(auth.uid).val() == true",
      ".write": false
    },
    "locations": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() == true"
    },
    "states": {
      "$location": {
        ".write": "root.child('auth').child(auth.uid).child($location).val() == true",
        ".read": true
      }
    },
    "audit": {
      "$location": {
        ".read": "root.child('auth').child(auth.uid).child($location).val() == true",
        "$eventId": {
          ".write": "!data.exists() && newData.exists() && root.child('auth').child(auth.uid).child($location).val() == true",
          ".validate": "newData.hasChildren(['timestamp', 'uid', 'sessionId', 'action', 'stateArea', 'changes']) && newData.child('uid').val() == auth.uid && newData.child('timestamp').isNumber() && newData.child('sessionId').isString() && newData.child('action').isString() && (newData.child('stateArea').val() == 'match' || newData.child('stateArea').val() == 'controller' || newData.child('stateArea').val() == 'view' || newData.child('stateArea').val() == 'perimeter' || newData.child('stateArea').val() == 'clubOverrides') && newData.child('changes').val() != null"
        },
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "perimeter": {
      "$location": {
        ".read": "root.child('auth').child(auth.uid).child($location).val() == true",
        ".write": false
      }
    },
    "presence": {
      "$location": {
        ".read": true,
        "$connectionId": {
          ".write": true,
          ".validate": "newData.hasChildren(['connectedAt']) && newData.child('connectedAt').isNumber()"
        }
      }
    }
  }
}

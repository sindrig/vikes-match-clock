# Copy to secrets.env and fill in real values.
# secrets.env is gitignored and must never be committed.

# Reusable, preauthorized, tagged Tailscale auth key.
# IMPORTANT: You MUST assign tag(s) to the key itself when generating it
# in the Tailscale admin console (Settings -> Keys -> Generate auth key -> Tags).
# The tags here must match those assigned to the key.
# If the SD card is lost, revoke/rotate this key immediately.
TS_AUTH_KEY="tskey-auth-REPLACE-ME"

# Two-letter Wi-Fi country code (ISO 3166-1 alpha-2). Required.
WIFI_COUNTRY="IS"

# Wi-Fi SSID and PSK (WPA2-Personal) — OPTIONAL backup uplink.
# Ethernet is the primary connection; NetworkManager only activates Wi-Fi
# when Ethernet is unavailable. Both must be set or both unset.
# PSK must be 8-63 characters. SSID must be <= 32 characters.
# Neither may contain double quotes.
# WIFI_SSID="MyNetwork"
# WIFI_PSK="MyPassword"

# Tailscale tags to advertise (comma-separated). REQUIRED.
# Each entry must match tag:[A-Za-z0-9_-]+
# Must match the tags assigned to the auth key above.
TS_TAGS="tag:gateway"

# Tailscale hostname for this device (optional, defaults to vikin-gateway).
# Must be 1-63 chars, alphanumeric/hyphens, starting with alphanumeric.
TS_HOSTNAME="vikin-gateway"

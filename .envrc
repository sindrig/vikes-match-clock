# Optional direnv integration. See docs/environment.md for loaders and modes.
PATH_add "$PWD/utils"
PATH_add "$PWD/node_modules/.bin"
dotenv_if_exists .envrc-local

# Existing operator helpers are opt-in; frontend/emulator work needs neither.
if [[ "${VIKES_USE_LAYOUT_PYTHON:-0}" == "1" ]]; then
  if ! type layout_python >/dev/null 2>&1; then
    log_error "VIKES_USE_LAYOUT_PYTHON requires the layout_python helper."
    return 1
  fi
  layout_python || return 1
fi

if [[ "${VIKES_USE_AWS_SSO_LOGIN:-0}" == "1" ]]; then
  if ! command -v aws-sso-login >/dev/null 2>&1; then
    log_error "VIKES_USE_AWS_SSO_LOGIN requires the operator's aws-sso-login helper."
    return 1
  fi
  : "${AWS_PROFILE:?Set AWS_PROFILE to an approved profile for aws-sso-login.}"
  aws-sso-login "$AWS_PROFILE" || return 1
fi

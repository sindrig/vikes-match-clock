# Firebase Realtime Database root URL (databaseURL for the Admin SDK).
PERIMETER_FIREBASE_DATABASE_URL=https://vikes-match-clock-firebase.firebaseio.com

# Database path of the perimeter state child (listened to via the Admin SDK).
PERIMETER_FIREBASE_PATH=states/vikuti/perimeter/state

# Service account private key JSON used by the Firebase Admin SDK.
# install.sh installs the file passed on its command line to this location.
PERIMETER_SERVICE_ACCOUNT_FILE=/etc/perimeter-control/perimeter-service-account.json

# Resolume Arena HTTP API base URL (reverse proxy on localhost:80).
PERIMETER_RESOLUME_BASE_URL=http://localhost:80/api/v1

# Column index that drives both perimeter outputs.
PERIMETER_RESOLUME_COLUMN=1

# HTTP timeout in seconds.
PERIMETER_REQUEST_TIMEOUT=10

# Seconds between listener refreshes (0 disables). Reopening the listener
# re-delivers the current state and bounds any transport stall.
PERIMETER_LISTENER_REFRESH_SECONDS=300

# Initial retry backoff in seconds (doubles on each failure).
PERIMETER_INITIAL_BACKOFF_SECONDS=1

# Maximum retry backoff in seconds.
PERIMETER_MAX_BACKOFF_SECONDS=60

# Set to "false" to disable the perimeter preview snapshot (columns, clips and
# bounded JPEG thumbnails) published to Realtime Database.
PERIMETER_PREVIEW_ENABLED=true

# Database path of the preview snapshot (outside the writable states/ subtree).
PERIMETER_PREVIEW_PATH=perimeter/vikuti

# Longest side of re-encoded clip thumbnails, in pixels.
PERIMETER_THUMBNAIL_MAX_DIM=320

# JPEG quality (0.1-1.0) used when re-encoding clip thumbnails.
PERIMETER_THUMBNAIL_QUALITY=0.7

# Per-clip thumbnail cap, in characters of the published data URL
# (the base64 data URL, not the raw JPEG). Thumbnails larger than this are
# omitted from the snapshot rather than inflating it.
PERIMETER_THUMBNAIL_MAX_BYTES=100000

# Whole-snapshot byte cap. A snapshot larger than this is rejected and the
# last published snapshot is kept.
PERIMETER_PREVIEW_MAX_BYTES=8000000

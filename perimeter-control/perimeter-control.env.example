# Brightness-only gateway. All venues use browser media playback.
# Legacy media settings in existing environment files are ignored.

# Firebase Realtime Database root URL (databaseURL for the Admin SDK).
PERIMETER_FIREBASE_DATABASE_URL=https://vikes-match-clock-firebase.firebaseio.com

# Database path of the perimeter state child (listened to via the Admin SDK).
PERIMETER_FIREBASE_PATH=states/vikuti/perimeter/state

# Service account private key JSON used by the Firebase Admin SDK.
# install.sh installs the file passed on its command line to this location.
PERIMETER_SERVICE_ACCOUNT_FILE=/etc/perimeter-control/perimeter-service-account.json

# Seconds between listener refreshes (0 disables). Reopening the listener
# re-delivers the current state and bounds any transport stall.
PERIMETER_LISTENER_REFRESH_SECONDS=300

# Brightness pre-write retry backoff in seconds (doubles on each failure).
PERIMETER_INITIAL_BACKOFF_SECONDS=1

# Maximum retry backoff in seconds.
PERIMETER_MAX_BACKOFF_SECONDS=60

# -- Perimeter brightness (Vnnox/UCenter LED brightness control) --------------

# Set to "true" to enable the brightness state machine. Vnnox handling stays
# DISABLED unless explicitly set to "true" — absent commands, missing
# configuration, or a disabled feature never touch a live screen.
PERIMETER_BRIGHTNESS_ENABLED=false

# Database path of the desired brightness command (client-written, daemon-read).
# The value is the requested integer percentage (0..100); null/missing means
# "no command" and is inert.
PERIMETER_BRIGHTNESS_PATH=states/vikuti/perimeter/brightness

# Database path where the daemon publishes brightness status (read-only for
# clients): requestedPercent, appliedPercent, phase (pending|applied|failed),
# safe error text, and a Firebase server timestamp. When automatic brightness
# is enabled the document additionally carries mode ("auto") and the live
# `predicted` readout; see the automatic brightness section below.
PERIMETER_BRIGHTNESS_STATUS_PATH=perimeter/vikuti/brightnessStatus

# -- Automatic brightness (sun + weather prediction) ---------------------------
# Replaces repeated manual brightness changes with an `automatic` mode that
# predicts the right percentage from the sun's position at the screen's
# location (exact, offline math) and Open-Meteo cloud cover (forecast,
# polled every 15 min). Weather data by Open-Meteo.com.
#
# Auto writes are ordinary integer commands dispatched through the same
# brightness worker (hysteresis >= 2 points, slew <= 15 points per write,
# one auto write per 60s tick, output clamped to [max(min,1), min(max,99)] —
# 0 and 100 are manual-only). Disabled by default; shadow mode (predictions
# published to the status document, no writes) runs whenever this flag is
# true, until the controller sets brightnessAuto.enabled=true.

# Set to "true" to enable the automatic brightness scheduler. Requires
# PERIMETER_BRIGHTNESS_ENABLED=true (auto writes go through that worker).
PERIMETER_AUTO_BRIGHTNESS_ENABLED=false

# Database path of the auto config (controller-written, daemon-read):
# { enabled, min, max, exponent, cloudWeight, luxMin, luxMax, updatedAt }.
PERIMETER_AUTO_BRIGHTNESS_PATH=states/vikuti/perimeter/brightnessAuto

# Database path where the daemon appends calibration entries (read-only for
# clients): one entry per applied auto change and per manual override while
# auto is enabled — { ts, source, percent, lux, sunElevationDeg, cloudCover }.
PERIMETER_BRIGHTNESS_CALIBRATION_PATH=perimeter/vikuti/brightnessCalibration

# Screen location for the sun-position math (decimal degrees, WGS84).
# Defaults are the Fossvogur perimeter screen; a ±1 km error is < 0.01° of
# sun elevation and irrelevant.
PERIMETER_LAT=64.117
PERIMETER_LNG=-21.91

# Scheduler tick seconds: at most one auto-initiated write per tick.
PERIMETER_AUTO_TICK_SECONDS=60

# Open-Meteo poll interval in seconds (the 15-min nowcast cadence).
PERIMETER_AUTO_WEATHER_POLL_SECONDS=900

# Slew limit: an auto write moves at most this many percentage points from
# the last applied value, so the screen never visibly jumps mid-match.
PERIMETER_AUTO_MAX_SLEW=15

# Set to "false" to allow auto writes even while the perimeter state is
# "off" (default skips them and recomputes immediately on off -> on).
PERIMETER_AUTO_SKIP_WHEN_OFF=true

# Open-Meteo forecast API base URL and IANA timezone for the hourly array.
PERIMETER_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
PERIMETER_AUTO_TIMEZONE=Atlantic/Reykjavik

# -- Vnnox connection (targets the UCenter service, normally on localhost:81) --

# Base URL of the UCenter web service reachable from the gateway.
PERIMETER_VNNOX_BASE_URL=http://localhost:81

# Target device identity: ip/port of the perimeter controller and the link
# protocol ("http", NOT the G4A protocolType). These headers route every
# UCenter call to the correct device.
PERIMETER_VNNOX_IP=10.182.45.40
PERIMETER_VNNOX_PORT=8088
PERIMETER_VNNOX_PROTOCOL=http

# Serial number of the perimeter controller device (used for screen reads).
# REQUIRED — the device is identified by serial, never by name.
PERIMETER_VNNOX_SN=

# UCenter project ID used for normal-screen reads.
PERIMETER_VNNOX_PROJECT_ID=defaultProject-vx

# GUID of the perimeter screen on the device. The daemon writes brightness
# ONLY to this screen — the MVR screen must never be targeted. REQUIRED; there
# is deliberately no default.
PERIMETER_VNNOX_PERIMETER_GUID=

# Retrieve the current device login from the gateway maintainer's credential store.
# Set the username explicitly before enabling brightness; do not assume a default.
PERIMETER_VNNOX_USERNAME=REPLACE_WITH_DEVICE_USERNAME

# Where the Vnnox password comes from. "env" reads PERIMETER_VNNOX_PASSWORD;
# "file" reads the first line of PERIMETER_VNNOX_PASSWORD_FILE. Retrieve the
# value through the gateway maintainer; never commit it.
PERIMETER_VNNOX_PASSWORD_SOURCE=env
#PERIMETER_VNNOX_PASSWORD=
#PERIMETER_VNNOX_PASSWORD_FILE=/etc/perimeter-control/vnnox-password

# Per-request HTTP timeout in seconds for Vnnox calls.
PERIMETER_VNNOX_TIMEOUT=10

# Bounded transient retries for the snapshot+write pre-write phase.
PERIMETER_BRIGHTNESS_MAX_RETRIES=3

# Verification polling: how many screen reads to take (with an interval
# between them) before declaring a mismatch, and the integer-percent tolerance
# between the requested and read brightness that counts as applied.
PERIMETER_BRIGHTNESS_VERIFY_ATTEMPTS=6
PERIMETER_BRIGHTNESS_VERIFY_TOLERANCE=1
PERIMETER_BRIGHTNESS_VERIFY_INTERVAL_SECONDS=1

# Firebase Realtime Database stream URL for the perimeter state child.
# The daemon appends ".json" and streams with Accept: text/event-stream.
PERIMETER_FIREBASE_URL=https://vikes-match-clock-firebase.firebaseio.com/states/vikuti/perimeter/state

# Resolume Arena HTTP API base URL (reverse proxy on localhost:80).
PERIMETER_RESOLUME_BASE_URL=http://localhost:80/api/v1

# Column index that drives both perimeter outputs.
PERIMETER_RESOLUME_COLUMN=1

# HTTP request timeout in seconds (connect + read).
PERIMETER_REQUEST_TIMEOUT=10

# Initial retry backoff in seconds (doubles on each failure).
PERIMETER_INITIAL_BACKOFF_SECONDS=1

# Maximum retry backoff in seconds.
PERIMETER_MAX_BACKOFF_SECONDS=60

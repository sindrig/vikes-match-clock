# Firebase Realtime Database root URL (databaseURL for the Admin SDK).
PERIMETER_FIREBASE_DATABASE_URL=https://vikes-match-clock-firebase.firebaseio.com

# Database path of the perimeter state child (listened to via the Admin SDK).
PERIMETER_FIREBASE_PATH=states/vikuti/perimeter/state

# Service account private key JSON used by the Firebase Admin SDK.
# install.sh installs the file passed on its command line to this location.
PERIMETER_SERVICE_ACCOUNT_FILE=/etc/perimeter-control/perimeter-service-account.json

# Resolume Arena HTTP API base URL (reverse proxy on localhost:80).
PERIMETER_RESOLUME_BASE_URL=http://localhost:80/api/v1

# Column index that drives both perimeter outputs.
PERIMETER_RESOLUME_COLUMN=1

# HTTP timeout in seconds.
PERIMETER_REQUEST_TIMEOUT=10

# Seconds between listener refreshes (0 disables). Reopening the listener
# re-delivers the current state and bounds any transport stall.
PERIMETER_LISTENER_REFRESH_SECONDS=300

# Initial retry backoff in seconds (doubles on each failure).
PERIMETER_INITIAL_BACKOFF_SECONDS=1

# Maximum retry backoff in seconds.
PERIMETER_MAX_BACKOFF_SECONDS=60

# Set to "false" to disable the perimeter preview snapshot (columns, clips and
# bounded JPEG thumbnails) published to Realtime Database.
PERIMETER_PREVIEW_ENABLED=true

# Database path of the preview snapshot (outside the writable states/ subtree).
PERIMETER_PREVIEW_PATH=perimeter/vikuti

# Longest side of re-encoded clip thumbnails, in pixels.
PERIMETER_THUMBNAIL_MAX_DIM=320

# JPEG quality (0.1-1.0) used when re-encoding clip thumbnails.
PERIMETER_THUMBNAIL_QUALITY=0.7

# Per-clip thumbnail cap, in characters of the published data URL
# (the base64 data URL, not the raw JPEG). Thumbnails larger than this are
# omitted from the snapshot rather than inflating it.
PERIMETER_THUMBNAIL_MAX_BYTES=100000

# Whole-snapshot byte cap. A snapshot larger than this is rejected and the
# last published snapshot is kept.
PERIMETER_PREVIEW_MAX_BYTES=8000000

# -- Perimeter overlay (goal-triggered video sequences) -----------------------

# Set to "false" to disable the overlay state machine.
PERIMETER_OVERLAY_ENABLED=true

# Database path of the overlay document (client-written, daemon-read).
PERIMETER_OVERLAY_PATH=states/vikuti/perimeter/overlay

# Database path where the daemon publishes overlay status (read-only for clients).
PERIMETER_OVERLAY_STATUS_PATH=perimeter/vikuti/overlayStatus

# Database path where the daemon publishes overlay target geometry (read-only
# for clients). Must be location-specific: a daemon serving venue `foo`
# publishes to perimeter/foo/overlayGeometry, matching the venue's other
# location-specific paths. A venue with no geometry document has no daemon, so
# the clock controller skips media preparation for it.
#PERIMETER_OVERLAY_GEOMETRY_PATH=perimeter/vikuti/overlayGeometry

# GCS bucket approved for overlay assets (goal files and named pairs).
# Must match the environment: staging uses
# vikes-match-clock-staging.appspot.com.
#PERIMETER_OVERLAY_BUCKET=vikes-match-clock-firebase.appspot.com

# GCP project ID for the Firebase Storage bucket (used by @google-cloud/storage).
PERIMETER_OVERLAY_GCP_PROJECT=vikes-match-clock-firebase

# Local cache directory for downloaded overlay assets. install.sh creates it
# (the systemd unit allows writes here under ProtectSystem=strict).
PERIMETER_OVERLAY_CACHE_DIR=/var/cache/perimeter-control

# SSH settings for copying assets to the Windows Resolume host.
# install.sh installs an SSH key to PERIMETER_OVERLAY_SSH_KEY when given a key
# path (defaults to the installing user's ~/.ssh/id_ed25519).
# The daemon uses a persistent known-hosts file at
# <PERIMETER_OVERLAY_CACHE_DIR>/known_hosts — the first connection to a host
# is trusted and remembered, subsequent connections verify against the saved key.
PERIMETER_OVERLAY_SSH_HOST=10.182.45.53
PERIMETER_OVERLAY_SSH_USER=user
PERIMETER_OVERLAY_SSH_KEY=/etc/perimeter-control/overlay-ssh-key

# Remote directory on the Windows host where assets are copied.
# Must never be overridden from Firebase. Only local config controls this path.
PERIMETER_OVERLAY_REMOTE_CONTENT_DIR=C:/Content

# Comma-separated Resolume layer IDs (1-based layer indices in the Efni deck)
# that are used for overlays. These must exist above the base content layers.
# For the Víkin composition: index 2 is the overlay above the 48 skjáir base
# layer and index 4 is the overlay above the 40 skjáir base layer.
PERIMETER_OVERLAY_LAYER_IDS=2,4

# JSON mapping of layer IDs to clip column slots.
# Each overlay layer must have at least one clip slot; this is the reference
# slot and the fallback when the live composition cannot be read. The daemon
# loads the overlay file into the currently active deck column and pauses the
# deck autopilot for the duration of the goal celebration (restoring it on
# clear), so the overlay keeps looping without mirroring the file everywhere.
# Overlay assets are copied to the Windows host with a generation suffix in the
# filename (e.g. goal-48-1234567890123.mp4) so same-size re-uploads from GCS
# are always picked up.
PERIMETER_OVERLAY_LAYER_CLIP_COLUMNS={"2":1,"4":1}

# JSON mapping of overlay layer IDs to their named media-pair target folder.
# Layer "2" is the 48-screen overlay and layer "4" is the 40-screen overlay, so
# named-pair files for each layer must live under
# perimeter-overlays/{pairId}/48/ and /40/ respectively. The daemon rejects a
# named-pair file whose folder does not match its layer's target. A partial
# override is merged over the default map, so omitted layers keep their folder.
PERIMETER_OVERLAY_LAYER_TARGET_FOLDERS={"2":"48","4":"40"}

# Resolume clip "Video -> Resize" fit mode applied to every overlay and ad clip
# the daemon opens. "Stretch" (default) scales the source to fill its layer's
# native canvas edge-to-edge, so a file with a non-native aspect ratio can
# never leave side gaps on the LED strip. Other Resolume options: Fill, Fit.
#PERIMETER_CLIP_FIT=Stretch

# Native content canvas ("WxH") per layer, applied together with
# PERIMETER_CLIP_FIT. A non-Original resize mode makes Resolume pin a clip's
# canvas to the layer output size (4608x192 for every layer here), which would
# stretch the 40-screen content (native 3840x192) beyond the LED strip;
# pinning the clip canvas back to the native size keeps the fill on the
# correct region. Native-size media is unaffected. A partial override is
# merged over the default map.
#PERIMETER_CLIP_CANVASES={"1":"4608x192","2":"4608x192","3":"3840x192","4":"3840x192"}

# Crossfade (seconds) applied when one overlay is swapped for another while it
# is playing. The daemon double-buffers the swap: the new overlay is loaded
# into a standby deck column while the old one keeps playing, then the daemon
# connects the standby column (a clip crossfade is set so the cutover dissolves
# instead of cutting) and clears the old column. "0" disables the crossfade —
# the swap is still double-buffered (no gap showing the base ads), just an
# instant cut.
#PERIMETER_OVERLAY_TRANSITION_SECONDS=0.5
# Resolume clip transition blend mode used for the overlay swap crossfade.
#PERIMETER_OVERLAY_TRANSITION_BLEND=Dissolve

# -- Perimeter ad layout (content deployer on the base layers) -----------------

# Set to "false" to disable the ad-layout state machine.
PERIMETER_AD_LAYOUT_ENABLED=true

# Database path of the ad-layout document (client-written, daemon-read).
PERIMETER_AD_LAYOUT_PATH=states/vikuti/perimeter/adLayout

# Database path where the daemon publishes ad-layout status (read-only for clients).
PERIMETER_AD_LAYOUT_STATUS_PATH=perimeter/vikuti/adLayout

# Comma-separated Resolume layer IDs (1-based layer indices in the Efni deck)
# used for ad layout. These must be the base content layers the deck autopilot
# cycles, and must be disjoint from PERIMETER_OVERLAY_LAYER_IDS. Each layout
# column maps 1:1 to a deck column (layout column i -> deck column i+1); the
# autopilot cycles the non-empty columns exactly like the Efni content and
# skips the empty trailing columns. For the Víkin composition the base layers
# are index 1 (48 skjáir) and index 3 (40 skjáir).
PERIMETER_AD_LANE_IDS=1,3

# GCS bucket allowed for ad-layout assets.
# Must match the environment: staging uses vikes-match-clock-staging.appspot.com.
#PERIMETER_AD_LAYOUT_BUCKET=vikes-match-clock-firebase.appspot.com

# Maximum file size in bytes for ad-layout assets downloaded from GCS.
#PERIMETER_AD_MAX_FILE_BYTES=262144000

# Value the deck autopilot target is asserted to when the perimeter turns "on".
# The ad-layout relies on this autopilot to cycle the deck columns (and the ads
# deployed into them); "on" restores the value, overriding any stale leftover
# (e.g. a pause from an older daemon build), so the deck can never get stuck on
# a single ad. A goal overlay pauses the autopilot while it plays and is never
# disturbed. "off" leaves the autopilot untouched.
#PERIMETER_DECK_AUTOPILOT=Play Next Column

# Deck autopilot column duration asserted on "on". "Longest Clip" lets a
# still-image column advance after Resolume's 1s still default while video
# columns play their full length, so the default is "Seconds" + 20 to keep
# every column (images included) on screen for a uniform 20s.
#PERIMETER_DECK_AUTOPILOT_DURATION=Seconds
#PERIMETER_DECK_AUTOPILOT_SECONDS=20

# -- Perimeter deck import (one-shot: Resolume deck -> ad-layout system) ------

# Set to "false" to disable the import state machine.
PERIMETER_IMPORT_ENABLED=true

# Database path of the import command document (client-written, daemon-read).
# A command is `{ commandId: "<uuid>", command: "from-resolume" }`; it is
# deduped by commandId and never re-imports on its own.
PERIMETER_IMPORT_PATH=states/vikuti/perimeter/import

# Database path where the daemon publishes the import result (read-only for
# clients).
PERIMETER_IMPORT_STATUS_PATH=perimeter/vikuti/importStatus

# -- Perimeter brightness (Vnnox/UCenter LED brightness control) --------------

# Set to "true" to enable the brightness state machine. Vnnox handling stays
# DISABLED unless explicitly set to "true" — absent commands, missing
# configuration, or a disabled feature never touch a live screen.
PERIMETER_BRIGHTNESS_ENABLED=false

# Database path of the desired brightness command (client-written, daemon-read).
# The value is the requested integer percentage (0..100); null/missing means
# "no command" and is inert.
PERIMETER_BRIGHTNESS_PATH=states/vikuti/perimeter/brightness

# Database path where the daemon publishes brightness status (read-only for
# clients): requestedPercent, appliedPercent, phase (pending|applied|failed),
# safe error text, and a Firebase server timestamp.
PERIMETER_BRIGHTNESS_STATUS_PATH=perimeter/vikuti/brightnessStatus

# -- Vnnox connection (targets the UCenter service, normally on localhost:81) --

# Base URL of the UCenter web service reachable from the gateway.
PERIMETER_VNNOX_BASE_URL=http://localhost:81

# Target device identity: ip/port of the perimeter controller and the link
# protocol ("http", NOT the G4A protocolType). These headers route every
# UCenter call to the correct device.
PERIMETER_VNNOX_IP=10.182.45.40
PERIMETER_VNNOX_PORT=8088
PERIMETER_VNNOX_PROTOCOL=http

# Serial number of the perimeter controller device (used for screen reads).
# REQUIRED — the device is identified by serial, never by name.
PERIMETER_VNNOX_SN=

# UCenter project ID used for normal-screen reads.
PERIMETER_VNNOX_PROJECT_ID=defaultProject-vx

# GUID of the perimeter screen on the device. The daemon writes brightness
# ONLY to this screen — the MVR screen must never be targeted. REQUIRED; there
# is deliberately no default.
PERIMETER_VNNOX_PERIMETER_GUID=

# Login username (stock default is "admin").
PERIMETER_VNNOX_USERNAME=admin

# Where the Vnnox password comes from. "env" reads PERIMETER_VNNOX_PASSWORD;
# "file" reads the first line of PERIMETER_VNNOX_PASSWORD_FILE. No production
# password is committed to this repository.
PERIMETER_VNNOX_PASSWORD_SOURCE=env
#PERIMETER_VNNOX_PASSWORD=
#PERIMETER_VNNOX_PASSWORD_FILE=/etc/perimeter-control/vnnox-password

# Per-request HTTP timeout in seconds for Vnnox calls.
PERIMETER_VNNOX_TIMEOUT=10

# Bounded transient retries for the snapshot+write pre-write phase.
PERIMETER_BRIGHTNESS_MAX_RETRIES=3

# Verification polling: how many screen reads to take (with an interval
# between them) before declaring a mismatch, and the integer-percent tolerance
# between the requested and read brightness that counts as applied.
PERIMETER_BRIGHTNESS_VERIFY_ATTEMPTS=6
PERIMETER_BRIGHTNESS_VERIFY_TOLERANCE=1
PERIMETER_BRIGHTNESS_VERIFY_INTERVAL_SECONDS=1
